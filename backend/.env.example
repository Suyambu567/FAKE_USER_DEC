# Copy to .env and adjust. Never commit the real .env.

# ---- service ---------------------------------------------------------------
APP_NAME=fake-profile-detector
APP_VERSION=2.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# ---- network ---------------------------------------------------------------
# Bind 127.0.0.1 on a shared or public-IP host and let a reverse proxy terminate
# TLS. Use 0.0.0.0 only inside a container network. The original Flask app
# hardcoded 0.0.0.0 with debug=True, which exposes the Werkzeug debugger console
# to anyone who can reach the port.
HOST=127.0.0.1
PORT=8000
WORKERS=2
ROOT_PATH=

# Host port that docker-compose publishes to (container port stays 8000).
# Port 8000 is heavily contended on shared machines -- check with
# `ss -ltn | grep :<port>` before picking one.
API_PORT=8200

# ---- CORS ------------------------------------------------------------------
# Comma-separated. Android/iOS ignore CORS; this is for Flutter Web.
# Narrow this to your real origins in production -- do not ship "*".
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# ---- model artifacts -------------------------------------------------------
# artifacts/xgb is the paper's XGBoost model (python -m ml.train_xgb).
# Set this to `artifacts` to serve the older RandomForest instead -- the
# service reads the feature style from the metadata and handles both.
ARTIFACTS_DIR=artifacts/xgb
MODEL_FILENAME=model.joblib
METADATA_FILENAME=model_meta.json
# Optional. Enables the class-distribution and engagement histogram in /analytics.
DATASET_PATH=

# ---- inference -------------------------------------------------------------
INFERENCE_MAX_CONCURRENCY=8
INFERENCE_TIMEOUT_SECONDS=5.0
MAX_BATCH_SIZE=100

# ---- username lookup (GET /api/v1/lookup/{username}) -----------------------
# Turns a username into the nine model features.
#
#   none  (default) endpoint returns 501. Clients must POST features directly.
#   mock            deterministic SYNTHETIC data. Development/demo only --
#                   the numbers are invented and the verdict is meaningless.
#   http            a third-party profile-data API (see below).
#
# Why not Instagram directly? The Graph API only exposes accounts you own or
# that authorised your app -- it cannot look up an arbitrary username. Scraping
# Instagram yourself violates their Terms of Service. A licensed data provider
# is the workable route.
PROFILE_PROVIDER=none

# Required when PROFILE_PROVIDER=http. Must contain the {username} placeholder.
PROFILE_API_URL=
PROFILE_API_KEY=
PROFILE_API_KEY_HEADER=X-API-Key
PROFILE_API_TIMEOUT_SECONDS=10.0

# Cache upstream lookups. Profile stats barely move minute to minute and every
# call costs money. 0 disables.
PROFILE_CACHE_TTL_SECONDS=900

# JSON object: wire field -> dotted path in the provider's response body.
# Only override the fields whose names differ from the defaults in
# app/services/profile_provider.py::HttpProfileProvider.DEFAULT_MAP.
# Example:
# PROFILE_FIELD_MAP={"followers":"data.user.edge_followed_by.count","bio_text":"data.user.biography"}
PROFILE_FIELD_MAP=

# ---- security --------------------------------------------------------------
# Leave blank to disable auth (development only).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
API_KEY_HEADER=X-API-Key

# ---- rate limiting ---------------------------------------------------------
# In-process counter: the effective limit is WORKERS x RATE_LIMIT_REQUESTS.
# Move to Redis before scaling past one box.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
